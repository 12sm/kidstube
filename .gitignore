# Environment variables (contains secrets)
.env

# SQLite database (runtime data, not source)
data/

# Downloaded media
downloads/

# Node modules
node_modules/
*/node_modules/

# Build artifacts
frontend/dist/
frontend/.vite/

# macOS
.DS_Store

# Claude Code — local settings and memory are machine-specific
.claude/settings.local.json
.claude/memory/

# Docker volumes / runtime
*.log

# Screenshots (reference images, not needed for the app)
screenshots/
*.docx

# Superpowers (local planning/design docs)
.superpowers/
docs/superpowers/

# Git worktrees
.worktrees/
invidious-repo/
.playwright-mcp/
