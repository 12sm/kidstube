# Environment variables (contains secrets)
.env

# SQLite database (runtime data, not source)
data/

# Downloaded media
downloads/

# Node modules
node_modules/
*/node_modules/

# Build artifacts
frontend/dist/
frontend/.vite/

# macOS
.DS_Store

# Claude Code — local settings are machine-specific, but .claude/memory/ is intentionally tracked
.claude/settings.local.json

# Docker volumes / runtime
*.log

# Playwright-generated screenshots (ephemeral, rebuilt on demand)
screenshots/playwright/
*.docx

# Git worktrees
.worktrees/

# Capacitor iOS — synced web assets (rebuilt via `npx cap sync`)
frontend/ios/App/App/public/

# Capacitor iOS — CocoaPods (not used; project uses SPM)
frontend/ios/App/Pods/
