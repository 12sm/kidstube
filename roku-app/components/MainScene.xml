<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/RemoteKeys.brs" />
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
    <children>
        <!-- Profile selection screen -->
        <Group id="profileUI">
            <Rectangle width="1280" height="720" color="0x0F0F0FFF" />
            <Label id="profileTitle" text="Who's watching?"
                   width="1280" horizAlign="center"
                   translation="[0, 180]"
                   font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
            <Group id="profileCards" translation="[0, 280]">
                <Group id="profile1Card" translation="[370, 0]">
                    <Rectangle id="profile1Bg" width="160" height="160" color="0x4CAF50FF" />
                    <Label id="profile1Initial" text="" width="160" height="160"
                           horizAlign="center" vertAlign="center"
                           font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
                    <Rectangle id="profile1Focus" width="160" height="160" color="0x00000000" />
                    <Label id="profile1Name" text="" width="160" horizAlign="center"
                           translation="[0, 172]"
                           font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
                </Group>
                <Group id="profile2Card" translation="[720, 0]">
                    <Rectangle id="profile2Bg" width="160" height="160" color="0xFF9800FF" />
                    <Label id="profile2Initial" text="" width="160" height="160"
                           horizAlign="center" vertAlign="center"
                           font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
                    <Rectangle id="profile2Focus" width="160" height="160" color="0x00000000" />
                    <Label id="profile2Name" text="" width="160" horizAlign="center"
                           translation="[0, 172]"
                           font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
                </Group>
            </Group>
        </Group>

        <!-- Main app layout (hidden until profile selected) -->
        <Group id="appLayout" visible="false">
            <NavBar id="navBar" />
            <Group id="contentArea" translation="[80, 0]">
                <Group id="homeWrapper" />
            </Group>
            <Group id="videoContainer" />

            <!-- Content shift animation when NavBar expands -->
            <Animation id="contentShiftAnim" duration="0.15" easeFunction="outCubic">
                <Vector2DFieldInterpolator
                    id="contentShiftInterp"
                    key="[0.0, 1.0]"
                    keyValue="[[80, 0], [200, 0]]"
                    fieldToInterp="contentArea.translation" />
            </Animation>
        </Group>
    </children>
</component>
